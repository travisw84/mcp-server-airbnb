{
  "name": "@traviswinsor84/mcp-server-airbnb",
  "version": "0.4.0",
  "description": "MCP server for Airbnb search and listing details",
  "license": "MIT",
  "type": "module",
  "author": "OpenBnB (https://openbnb.org)",
  "keywords": [
    "airbnb",
    "vacation rental",
    "travel"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mcp-server-airbnb": "dist/index.js"
  },
  "files": [
    "dist",
    "sync-version.js",
    "!dist/*.mcpb",
    "skills",
    "UPSTREAM.md",
    "manifest.json"
  ],
  "scripts": {
    "build": "node sync-version.js && tsc && shx chmod +x dist/*.js",
    "pack": "npm run build && npx @anthropic-ai/mcpb pack . dist/mcp-server-airbnb.mcpb",
    "prepare": "npm run build",
    "version": "node sync-version.js && git add manifest.json",
    "pretest": "npm run build",
    "test": "node test-domain-handoff.js && node --test test/*.test.mjs",
    "pretest:live": "npm run build",
    "test:live": "node test-extension.js && node test-amenities.js",
    "watch": "tsc --watch",
    "sync-version": "node sync-version.js",
    "pack:release": "npm pack"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TravisWinsor84/mcp-server-airbnb.git"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
